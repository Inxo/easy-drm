# CENC AES-128 key, 32 hex chars (16 bytes) — generate with: openssl rand -hex 16
# The packager prints both values if you run it without key/kid arguments.
CENC_KEY=00000000000000000000000000000000

# CENC key ID, 32 hex chars (16 bytes) — generate with: openssl rand -hex 16
CENC_KID=00000000000000000000000000000000

# HMAC secret for player tokens — generate with: openssl rand -hex 32
TOKEN_SECRET=your_token_signing_secret_here

# HTTP port (optional, default 8080)
#PORT=8080
